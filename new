)
chi2, p, dof, expected = stats.chi2_contingency(table)
print(f"chi2 = {chi2:.2f}, p = {p:.4f}, dof = {dof}")

import pandas as pd
import statsmodels.formula.api as smf

df9 = pd.DataFrame({
     "ad": [10, 12, 15, 11, 18, 20, 14, 16, 22, 13, 19, 17],
     "price": [100, 100, 95, 105, 95, 90, 100, 98, 90, 102, 92, 96],
     "sales": [200, 215, 250, 205, 280, 300, 230, 255, 320, 215, 290, 265],
     "region": ["Seoul"] * 6 + ["Busan"] * 6,
})

model = smf.ols("sales ~ ad", data = df9).fit()
print(model.summary())
#광고비가 1 늘면 매출이 10 증가

model2 = smf.ols("sales ~ ad + price", data = df9).fit()
print(model2.summary())
#ad는 8.7로 줄었고 price는 -1.5가 나왔어. 가격이 오르면 매출이 떨어지는 게 할인하는 이유랑 비슷하지 않을까 싶어.

print(df9[["ad", "price"]].corr())
#-0.91인데 음의 상관관계인건가?

model3 = smf.ols("sales ~ ad + price + C(region)", data = df9).fit()
print(model3.summary())
#부산 대비 서울이 4.3배라는 것 같아. 신뢰구간이 0을 포함하는데 무슨 의미인지는 모르겠어.

print(model2.conf_int())
#아깐 10이었는데 지금은 9.7~11.3이야. 뭐가 더 좋은지 잘 모르겠어.

#광고비를 올려서 많은 사람들이 더 많이 샀느냐가 중요한 것 같은데 그 정보가 없어.