import pandas as pd
import numpy as np
from scipy import stats

seoul_b_feb = [78, 80, 77, 79, 76, 81, 78, 79]
seoul_b_mar = [41, 38, 40, 43, 39, 42, 40, 37]

busan_b_feb = [48, 50, 47, 49, 51, 48, 50, 49]
busan_b_mar = [49, 47, 50, 48, 51, 49, 48, 50]

t, p = stats.ttest_ind(seoul_b_feb, seoul_b_mar, equal_var = False)
print(f"t = {t:.2f}, p = {p:.17f}")
#귀무가설은 "2월과 3월의 평균이 같다."
#p-value가 매우 작으므로 0.05보다 작아 귀무가설을 기각할 수 있다.
#평균은 같지 않다.

t, p = stats.ttest_ind(busan_b_feb, busan_b_mar, equal_var = False)
print(f"t = {t:.2f}, p = {p:.4f}")
#p-value가 1로 평균은 같다. 고로 변화가 있었다고 할 수 없다.

u, p = stats.mannwhitneyu(seoul_b_feb, seoul_b_mar)
print(f"u = {u:.2f}, p = {p:.4f}")
#1번은 p-value가 소수점 15자리까지 가야 했는데 지금은 4자리만에 나왔다.

x = [10, 20, 30, 40, 50, 60, 70]
y = [12, 25, 29, 44, 48, 65, 300]

r, p = stats.pearsonr(x, y)
print(f"r = {r:.2f}, p = {p:.4f}")
rho, p = stats.spearmanr(x, y)
print(f"rho = {rho:.2f}, p = {p:.4f}")

x2 = x[:-1]
y2 = y[:-1]

r, p = stats.pearsonr(x2, y2)
print(f"r = {r:.2f}, p = {p:.4f}")
rho, p = stats.spearmanr(x2, y2)
print(f"rho = {rho:.2f}, p = {p:.4f}")

#spearmanr가 더 많이 변함

